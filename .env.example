# Copy to .env and fill in real values. NEVER commit .env / .env.local.
# See SECRETS.md for scope minimization and rotation guidance.

# --- GraphQL MCP Server (mcp/graphql-mcp) ---
PORT=3000
GRAPHQL_MCP_ENDPOINT=https://api.github.com/graphql
GRAPHQL_API_KEY=your_github_token_here          # fine-grained, read-only; rotate every 90 days
AUTH_TYPE=Bearer                                # Bearer | x-api-key | none
GRAPHQL_READ_ONLY=true                          # block mutations
LOG_LEVEL=info

# Optional query guardrails (defaults preserve behavior)
GRAPHQL_MAX_DEPTH=15
GRAPHQL_COMPLEXITY_LIMIT=0                       # 0 = disabled; recommended 1000 when exposed
# INTROSPECTION_ALLOWLIST=https://api.github.com/graphql   # comma-separated; empty = allow configured endpoint
METRICS_ENABLED=true                            # expose GET /metrics

# --- Open WebUI ---
OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
ENABLE_OPENAI_API=true
WEBUI_SECRET_KEY=change-me-in-production         # e.g. openssl rand -hex 32

# --- MindsDB (db-mcp) ---
MINDSDB_APIS=http,mysql
MINDSDB_PORT_HTTP=47334
